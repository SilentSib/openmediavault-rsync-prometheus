#!/bin/sh
set -e

case "$1" in
    install|upgrade)
        # OMV 8: Create log directory and ensure systemd services can write to it
        install -d -m 0755 /var/log
        touch /var/log/omv-rsync-prometheus.log
        chmod 0640 /var/log/omv-rsync-prometheus.log
        
        # Handle upgrade from OMV 7: Remove old Salt cache
        rm -rf /var/cache/salt/minion/files/base/omv/deploy/rsync-prometheus 2>/dev/null || true
        rm -rf /var/cache/salt/minion/extmods/ 2>/dev/null || true
        rm -rf /srv/salt/omv/deploy/rsync-prometheus 2>/dev/null || true
        ;;
esac

#DEBHELPER#
exit 0
