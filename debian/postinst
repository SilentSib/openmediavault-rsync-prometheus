#!/bin/sh
set -e

. /usr/share/openmediavault/scripts/helper-functions

case "$1" in
    configure)
        # Seed config.xml with our default settings.
        omv-confdbadm create "conf.service.rsyncp"

        # Compile workbench YAML into the web interface.
        omv-mkworkbench all

        # OMV 8: Start systemd service directly (no Salt)
        systemctl daemon-reload || true
        if omv_config_get /config/services/rsyncp/enable | grep -q 1; then
            systemctl enable --now omv-rsync-prometheus.service || true
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#
exit 0
